# Paths used by the Rail B bitmap dumpers in the dirplayer-rs fork.
# Copy this file to .env, edit the paths, then `source .env` before
# running `cargo test ...` from inside the fork checkout.
#
# The `export` prefix is required — without it, sourced variables stay
# local to the current shell and are NOT inherited by cargo (silent
# failure: dumpers fall back to their default ./casts and ./out paths).

# Where the cast files (.cct, .dcr) live on your filesystem.
# Required. The fork dumpers read .cct files from here.
export CASTS_ROOT=/abs/path/to/cokemusic-casts

# Where bitmap PNGs + _members.json sidecars get written.
# Required. The dumpers create <OUTPUT_ROOT>/rooms/<room_id>/...
# (publicroom + studio outputs), <OUTPUT_ROOT>/ui/... (engine cast
# libs), <OUTPUT_ROOT>/furniture/... (cc_furniture metadata), and
# <OUTPUT_ROOT>/games/recycler/... (Recycler mini-game .dcr output).
export OUTPUT_ROOT=/abs/path/to/output

# Where Rail A's extracted/<room>.json files live.
# Optional. If set, dump_cct_bitmaps uses canonical.roomBitmaps to
# filter the FG members it dumps per room. If unset or pointed at a
# nonexistent directory, every FG bitmap in each cct is dumped (a
# superset). Strangers without Rail A output can leave this unset.
export ROOM_JSON_DIR=/abs/path/to/extracted

# Path to FurniFactory2.dcr (Recycler mini-game).
# Only required for dump_dcr_bitmaps.
# Note: in the canonical archive layout, games/ is typically a sibling
# of CASTS_ROOT (which is .../client2/), not a child of it.
export DCR_PATH=/abs/path/to/games/FurniFactory/FurniFactory2.dcr
